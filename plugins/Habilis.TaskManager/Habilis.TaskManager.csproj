<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>Habilis Terminal plugin: a live, read-only process list modelled on Windows Task Manager Details.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HabilisTerminal.Plugins.Sdk" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Habilis.TaskManager.Tests" />
  </ItemGroup>
</Project>
