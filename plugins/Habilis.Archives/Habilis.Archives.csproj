<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Description>Habilis Terminal plugin: archives as folders, on 7-Zip (on a Mac the system's libarchive, reading only). Copy out and in, delete, make folder where 7-Zip writes the format.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="HabilisTerminal.Plugins.Sdk" PrivateAssets="all" ExcludeAssets="runtime" />
  </ItemGroup>
  <ItemGroup>
    <!-- Both architectures: a plugin is one folder whatever the app's architecture is. -->
    <None Include="..\..\third_party\7-Zip\win-x64\7z.dll" Link="native\win-x64\7z.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\third_party\7-Zip\win-arm64\7z.dll" Link="native\win-arm64\7z.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Habilis.Archives.Tests" />
  </ItemGroup>
</Project>
