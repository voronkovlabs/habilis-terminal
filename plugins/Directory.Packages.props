<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- The host's SDK, from the local feed (tools/plugins/Build-Plugins.ps1 packs it). Never copied with a plugin. -->
    <PackageVersion Include="HabilisTerminal.Plugins.Sdk" Version="1.7.0" />
    <PackageVersion Include="HabilisTerminal.Plugins.Sdk.Wpf" Version="1.7.0" />
    <!-- AWS SDK for .NET, Apache 2.0. -->
    <PackageVersion Include="AWSSDK.Core" Version="4.0.102.16" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104.8" />
    <PackageVersion Include="AWSSDK.SQS" Version="4.0.100.22" />
    <PackageVersion Include="AWSSDK.SageMaker" Version="4.0.124" />
    <PackageVersion Include="AWSSDK.Pricing" Version="4.0.100.20" />
    <PackageVersion Include="AWSSDK.CloudWatch" Version="4.0.106" />
    <PackageVersion Include="AWSSDK.SecurityToken" Version="4.0.101.7" />
    <PackageVersion Include="AWSSDK.SSO" Version="4.0.100.23" />
    <PackageVersion Include="AWSSDK.SSOOIDC" Version="4.0.100.22" />
    <!-- Tests. -->
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
  </ItemGroup>
</Project>
