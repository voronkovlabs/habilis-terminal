<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <!-- Integration tests host a real pseudo console: same native layout as the app (Windows; issue #259). -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(HabiTarget)' != 'portable'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(HabiTarget)' != 'portable'" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HabilisTerminal.Shell\HabilisTerminal.Shell.csproj" />
  </ItemGroup>
</Project>
