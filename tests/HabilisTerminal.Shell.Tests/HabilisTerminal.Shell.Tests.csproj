    <ConptyRequiresx64Host>true</ConptyRequiresx64Host>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HabilisTerminal.Shell\HabilisTerminal.Shell.csproj" />
  </ItemGroup>
</Project>
