<Project>
  <PropertyGroup>
    <!-- Windows builds target Windows; elsewhere, or with -p:HabiTarget=portable, everything is net10.0 (issue #259). -->
    <TargetFramework Condition="$([MSBuild]::IsOSPlatform('Windows')) And '$(HabiTarget)' != 'portable'">net10.0-windows</TargetFramework>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Authors>Sergei Voronkov</Authors>
    <Product>Habilis Terminal</Product>
    <!-- Release builds pass -p:Version from the git tag. -->
    <Version>0.1.0</Version>
    <Copyright>Copyright (c) 2026 Sergei Voronkov</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
</Project>
