<Window x:Class="HabilisTerminal.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:HabilisTerminal.App.Layout"
        Title="Habilis Terminal"
        Width="1200" Height="800"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="None"
        KeyboardNavigation.ControlTabNavigation="None"
        KeyboardNavigation.DirectionalNavigation="None">
    <!-- Focus moves only through our own keys (Tab, Ctrl+Tab), never through WPF keyboard navigation. -->
    <DockPanel x:Name="Root" LastChildFill="True">
    <Grid>
        <layout:WorkspaceLayout x:Name="Workspace"
                                KeyboardNavigation.TabNavigation="None"
                                KeyboardNavigation.ControlTabNavigation="None"
                                KeyboardNavigation.DirectionalNavigation="None" />
        <!-- Full-window pages (viewer, editor, settings). The workspace is hidden, not collapsed, while a page is
             shown, so the terminal keeps its size and the shell is not resized. -->
        <ContentControl x:Name="PageHost" Visibility="Collapsed" Focusable="False" />
    </Grid>
    </DockPanel>
</Window>
