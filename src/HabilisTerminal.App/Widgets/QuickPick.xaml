<UserControl x:Class="HabilisTerminal.App.Widgets.QuickPick"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <!-- quickInput / list colors (VS Code Dark Modern); themed in stage 5. -->
        <SolidColorBrush x:Key="Foreground" Color="#CCCCCC" />
        <SolidColorBrush x:Key="Description" Color="#9D9D9D" />
        <SolidColorBrush x:Key="Selection" Color="#04395E" />
        <SolidColorBrush x:Key="Hover" Color="#2A2D2E" />
        <SolidColorBrush x:Key="Accent" Color="#0078D4" />
        <Style x:Key="PickItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource Foreground}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="8,3,8,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{StaticResource Selection}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="#202020" BorderBrush="#454545" BorderThickness="1" CornerRadius="6" Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Margin="4,0,4,6"
                       Foreground="{StaticResource Description}" FontSize="12" />
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBox x:Name="Filter" Background="#313131" Foreground="{StaticResource Foreground}"
                         CaretBrush="{StaticResource Foreground}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                         Padding="6,4" />
                <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="9,5,0,0"
                           Foreground="#6E6E6E" />
            </Grid>
            <ListBox x:Name="List" MaxHeight="420" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource PickItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Group}" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVisibility}}"
                                       Foreground="{StaticResource Description}" FontSize="11" Margin="0,6,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           VerticalAlignment="Center" Foreground="{StaticResource Description}" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Description}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{StaticResource Description}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="3" Margin="12,0,0,0" MinWidth="120" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail}" HorizontalAlignment="Right" FontSize="12"
                                               Foreground="{StaticResource Description}" />
                                    <ProgressBar Height="3" Margin="0,2,0,0" Minimum="0" Maximum="1" Value="{Binding Usage, Mode=OneWay}"
                                                 Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}"
                                                 Background="#3C3C3C" Foreground="{StaticResource Accent}" BorderThickness="0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
