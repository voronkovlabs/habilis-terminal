<UserControl x:Class="HabilisTerminal.App.Widgets.QuickPick"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="520"
             FontFamily="Segoe UI" FontSize="13">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <Style x:Key="PickItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource Habi.Foreground}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Row" Background="Transparent" CornerRadius="3" Padding="8,3,8,3">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Habi.Hover}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Habi.Selection}" />
                                <Setter Property="Foreground" Value="{DynamicResource Habi.SelectionForeground}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Background="{DynamicResource Habi.WidgetBackground}" BorderBrush="{DynamicResource Habi.WidgetBorder}" BorderThickness="1" CornerRadius="6" Padding="6">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.5" Color="Black" />
        </Border.Effect>
        <DockPanel>
            <TextBlock x:Name="TitleText" DockPanel.Dock="Top" Margin="4,0,4,6"
                       Foreground="{DynamicResource Habi.Description}" FontSize="12" />
            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                <TextBox x:Name="Filter" Background="{DynamicResource Habi.InputBackground}" Foreground="{DynamicResource Habi.Foreground}"
                         CaretBrush="{DynamicResource Habi.Foreground}" BorderBrush="{DynamicResource Habi.Accent}" BorderThickness="1"
                         Padding="6,4" />
                <TextBlock x:Name="Placeholder" IsHitTestVisible="False" Margin="9,5,0,0"
                           Foreground="{DynamicResource Habi.Placeholder}" />
            </Grid>
            <ListBox x:Name="List" MaxHeight="420" Background="Transparent" BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ItemContainerStyle="{StaticResource PickItem}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <TextBlock Text="{Binding Group}" Visibility="{Binding HasGroup, Converter={StaticResource BoolToVisibility}}"
                                       Foreground="{DynamicResource Habi.Description}" FontSize="11" Margin="0,6,0,2" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Path Grid.Column="0" Data="{Binding IconGeometry}" Width="14" Height="14" Stretch="Uniform"
                                      HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource Habi.Description}" />
                                <TextBlock Grid.Column="1" Text="{Binding Label}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Description}" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource Habi.Description}" TextTrimming="CharacterEllipsis" />
                                <StackPanel Grid.Column="3" Margin="12,0,0,0" MinWidth="120" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Detail}" HorizontalAlignment="Right" FontSize="12"
                                               Foreground="{DynamicResource Habi.Description}" />
                                    <ProgressBar Height="3" Margin="0,2,0,0" Minimum="0" Maximum="1" Value="{Binding Usage, Mode=OneWay}"
                                                 Visibility="{Binding HasUsage, Converter={StaticResource BoolToVisibility}}"
                                                 Background="{DynamicResource Habi.ProgressTrack}" Foreground="{DynamicResource Habi.Progress}" BorderThickness="0" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</UserControl>
