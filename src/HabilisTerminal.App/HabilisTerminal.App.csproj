<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Which build (issue #259): 'windows' on Windows, 'portable' (net10.0, macOS and Linux) elsewhere. On Windows,
         -p:HabiTarget=portable builds the portable one, so the analyzer shows Windows calls left unguarded. -->
    <HabiTarget Condition="'$(HabiTarget)' == '' And $([MSBuild]::IsOSPlatform('Windows'))">windows</HabiTarget>
    <HabiTarget Condition="'$(HabiTarget)' == ''">portable</HabiTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HabiTarget)' == 'windows'">
    <!-- The Windows version in the framework brings the Windows APIs: Windows.Data.Pdf for quick view (issue #110). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- A concrete RID puts conpty.dll next to habi.exe (Microsoft.Windows.Console.ConPTY). -->
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup Condition="'$(HabiTarget)' == 'portable'">
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <DefineConstants>$(DefineConstants);PORTABLE</DefineConstants>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The UI is Avalonia (issue #253): compiled bindings, no WPF. -->
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <AssemblyName>habi</AssemblyName>
    <RootNamespace>HabilisTerminal.App</RootNamespace>
    <StartupObject>HabilisTerminal.App.Program</StartupObject>
    <ApplicationIcon Condition="Exists('Assets\habi.ico')">Assets\habi.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup>
    <!-- The ConPTY package derives these from PlatformTarget too early to see the RID;
         without them OpenConsole.exe is not copied and the inbox conhost is used instead. -->
    <ConptyRequiresx64Host Condition="'$(RuntimeIdentifier)' == 'win-x64'">true</ConptyRequiresx64Host>
    <ConptyRequiresARM64Host Condition="'$(RuntimeIdentifier)' == 'win-x64' Or '$(RuntimeIdentifier)' == 'win-arm64'">true</ConptyRequiresARM64Host>
  </PropertyGroup>
  <PropertyGroup>
    <!-- Startup (issue #136): published code comes compiled, and less compiling goes on in the background afterwards. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <TieredPGO>false</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.AvaloniaEdit" />
    <PackageReference Include="Microsoft.Windows.Console.ConPTY" Condition="'$(HabiTarget)' == 'windows'" />
    <PackageReference Include="Velopack" />
  </ItemGroup>
  <ItemGroup>
    <!-- Codicons (CC BY 4.0) for UI glyphs. -->
    <AvaloniaResource Include="Assets\codicon.ttf" />
    <AvaloniaResource Include="Assets\habi.ico" />
    <None Include="..\..\ThirdPartyNotices.txt" Link="ThirdPartyNotices.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <!-- The client of the plugin API (issue #150): whoever writes a plugin needs it without the repository. -->
    <None Include="..\..\tools\plugins\habi-plugin.ps1" Link="habi-plugin.ps1" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\tools\plugins\New-Plugin.ps1" Link="New-Plugin.ps1" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Skia's and HarfBuzz's native symbols (100 MB) stay out of the published app (issue #253). -->
  <Target Name="DropNativeSymbols" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb' And ('%(Filename)' == 'libSkiaSharp' Or '%(Filename)' == 'libHarfBuzzSharp')" />
    </ItemGroup>
  </Target>
  <ItemGroup Condition="'$(CrashReportToken)' != ''">
    <!-- The release workflow passes the crash and feedback report token (CRASH_REPORT_TOKEN, base64 of the reversed
         token); it is never committed. Without it reports open the new-issue page in the browser. -->
    <AssemblyMetadata Include="CrashReportToken" Value="$(CrashReportToken)" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="HabilisTerminal.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\HabilisTerminal.Core\HabilisTerminal.Core.csproj" />
    <ProjectReference Include="..\HabilisTerminal.Plugins.Sdk\HabilisTerminal.Plugins.Sdk.csproj" />
    <ProjectReference Include="..\HabilisTerminal.Plugins.Sdk.Avalonia\HabilisTerminal.Plugins.Sdk.Avalonia.csproj" />
    <ProjectReference Include="..\HabilisTerminal.Shell\HabilisTerminal.Shell.csproj" />
    <ProjectReference Include="..\HabilisTerminal.Terminal\HabilisTerminal.Terminal.csproj" />
    <ProjectReference Include="..\HabilisTerminal.Themes\HabilisTerminal.Themes.csproj" />
  </ItemGroup>
</Project>
