<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Contracts only: no Windows or WPF dependency, so plugins stay UI-framework free (docs/plugins.md). -->
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HabilisTerminal.Plugins</RootNamespace>
    <!--
      The SDK has its own version, never the app's: release builds pass -p:Version for the app, a global property that
      reaches every project. Plugins bind to this assembly version, so it must not move with the app (issue #60).
      Change it only with a new SDK version (PluginManifest.HostSdkVersion, plugins' "sdk").
    -->
    <SdkVersion>1.5.0</SdkVersion>
    <AssemblyVersion>$(SdkVersion).0</AssemblyVersion>
    <FileVersion>$(SdkVersion).0</FileVersion>
    <PackageVersion>$(SdkVersion)</PackageVersion>
    <InformationalVersion>$(SdkVersion)</InformationalVersion>
    <IsPackable>true</IsPackable>
    <PackageId>HabilisTerminal.Plugins.Sdk</PackageId>
    <Description>SDK for Habilis Terminal plugins: plugin entry points, plugin panels, operations and host services.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
