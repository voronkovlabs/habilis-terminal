{
	// Far Manager's classic blue scheme (issue #42): navy panels, aqua text, yellow marked files, teal cursor,
	// black command line with the legacy Windows console palette. Muted (issue #282): the pure console colours
	// (#000080, #00FFFF, #FFFF00) were too bright to look at for long, so each is a softer, less saturated shade.
	// Not tinted with the Windows accent colour.
	"$schema": "vscode://schemas/color-theme",
	"name": "Far Manager",
	"type": "dark",
	"colors": {
		"foreground": "#8CCFCF",
		"descriptionForeground": "#6AA6A6",
		"errorForeground": "#E07A7A",
		"focusBorder": "#6FB8B8",
		"icon.foreground": "#C8D0D8",
		"widget.border": "#4F8F99",

		"sideBar.background": "#15294A",
		"sideBar.foreground": "#8CCFCF",
		"sideBar.border": "#4F8F99",
		"sideBarSectionHeader.background": "#15294A",
		"sideBarSectionHeader.foreground": "#D9C978",

		"list.activeSelectionBackground": "#3A8586",
		"list.activeSelectionForeground": "#0B1626",
		"list.inactiveSelectionBackground": "#21456A",
		"list.focusOutline": "#3A8586",
		"list.hoverBackground": "#1D365E",
		"list.highlightForeground": "#D9C978",
		"gitDecoration.modifiedResourceForeground": "#D9C978",

		"titleBar.activeBackground": "#2F7172",
		"titleBar.activeForeground": "#0B1626",
		"titleBar.inactiveBackground": "#285C5D",
		"titleBar.inactiveForeground": "#0B1626",

		"input.background": "#0E1522",
		"input.foreground": "#8CCFCF",
		"input.border": "#4F8F99",
		"input.placeholderForeground": "#4E8080",
		"quickInput.background": "#1D365E",
		"quickInput.foreground": "#8CCFCF",
		"editorWidget.background": "#1D365E",
		"editorWidget.border": "#4F8F99",

		"button.background": "#3A8586",
		"button.foreground": "#0B1626",
		"button.hoverBackground": "#479A9B",
		"button.secondaryBackground": "#15294A",
		"button.secondaryForeground": "#8CCFCF",

		"progressBar.background": "#6FB8B8",
		"scrollbarSlider.background": "#8CCFCF40",
		"scrollbarSlider.hoverBackground": "#8CCFCF70",
		"scrollbarSlider.activeBackground": "#8CCFCF99",

		"editor.background": "#15294A",
		"editor.foreground": "#8CCFCF",
		"editor.selectionBackground": "#3A8586",
		"editor.lineHighlightBackground": "#1D365E",
		"editorCursor.foreground": "#D9C978",
		"editorLineNumber.foreground": "#4E8080",

		"panel.background": "#0E1522",
		"panel.border": "#4F8F99",
		"terminal.background": "#0E1522",
		"terminal.foreground": "#B8BEC4",
		"terminal.selectionBackground": "#3E5570",
		"terminalCursor.foreground": "#B8BEC4",
		"terminal.ansiBlack": "#0E1522",
		"terminal.ansiRed": "#A64B4B",
		"terminal.ansiGreen": "#4E8E52",
		"terminal.ansiYellow": "#A09048",
		"terminal.ansiBlue": "#3D5A94",
		"terminal.ansiMagenta": "#8C5290",
		"terminal.ansiCyan": "#3E8C8C",
		"terminal.ansiWhite": "#B8BEC4",
		"terminal.ansiBrightBlack": "#6B7480",
		"terminal.ansiBrightRed": "#E07A7A",
		"terminal.ansiBrightGreen": "#86C78A",
		"terminal.ansiBrightYellow": "#D9C978",
		"terminal.ansiBrightBlue": "#7896DC",
		"terminal.ansiBrightMagenta": "#C489C8",
		"terminal.ansiBrightCyan": "#8CCFCF",
		"terminal.ansiBrightWhite": "#E2E6EA"
	},
	"tokenColors": []
}
