{
	// Far Manager's classic blue scheme (issue #42): navy panels, aqua text, yellow marked files, teal cursor,
	// black command line with the legacy Windows console palette. Not tinted with the Windows accent colour.
	"$schema": "vscode://schemas/color-theme",
	"name": "Far Manager",
	"type": "dark",
	"colors": {
		"foreground": "#00FFFF",
		"descriptionForeground": "#00C0C0",
		"errorForeground": "#FF5555",
		"focusBorder": "#00FFFF",
		"icon.foreground": "#FFFFFF",
		"widget.border": "#00FFFF",

		"sideBar.background": "#000080",
		"sideBar.foreground": "#00FFFF",
		"sideBar.border": "#00FFFF",
		"sideBarSectionHeader.background": "#000080",
		"sideBarSectionHeader.foreground": "#FFFF00",

		"list.activeSelectionBackground": "#008080",
		"list.activeSelectionForeground": "#000000",
		"list.inactiveSelectionBackground": "#004C80",
		"list.focusOutline": "#008080",
		"list.hoverBackground": "#0000A8",
		"list.highlightForeground": "#FFFF00",
		"gitDecoration.modifiedResourceForeground": "#FFFF00",

		"titleBar.activeBackground": "#008080",
		"titleBar.activeForeground": "#000000",
		"titleBar.inactiveBackground": "#006060",
		"titleBar.inactiveForeground": "#000000",

		"input.background": "#000000",
		"input.foreground": "#00FFFF",
		"input.border": "#00FFFF",
		"input.placeholderForeground": "#008080",
		"quickInput.background": "#0000A8",
		"quickInput.foreground": "#00FFFF",
		"editorWidget.background": "#0000A8",
		"editorWidget.border": "#00FFFF",

		"button.background": "#008080",
		"button.foreground": "#000000",
		"button.hoverBackground": "#00A0A0",
		"button.secondaryBackground": "#000080",
		"button.secondaryForeground": "#00FFFF",

		"progressBar.background": "#00FFFF",
		"scrollbarSlider.background": "#00FFFF55",
		"scrollbarSlider.hoverBackground": "#00FFFF88",
		"scrollbarSlider.activeBackground": "#00FFFFAA",

		"editor.background": "#000080",
		"editor.foreground": "#00FFFF",
		"editor.selectionBackground": "#008080",
		"editor.lineHighlightBackground": "#0000A8",
		"editorCursor.foreground": "#FFFF00",
		"editorLineNumber.foreground": "#008080",

		"panel.background": "#000000",
		"panel.border": "#00FFFF",
		"terminal.background": "#000000",
		"terminal.foreground": "#C0C0C0",
		"terminal.selectionBackground": "#808080",
		"terminalCursor.foreground": "#C0C0C0",
		"terminal.ansiBlack": "#000000",
		"terminal.ansiRed": "#800000",
		"terminal.ansiGreen": "#008000",
		"terminal.ansiYellow": "#808000",
		"terminal.ansiBlue": "#000080",
		"terminal.ansiMagenta": "#800080",
		"terminal.ansiCyan": "#008080",
		"terminal.ansiWhite": "#C0C0C0",
		"terminal.ansiBrightBlack": "#808080",
		"terminal.ansiBrightRed": "#FF0000",
		"terminal.ansiBrightGreen": "#00FF00",
		"terminal.ansiBrightYellow": "#FFFF00",
		"terminal.ansiBrightBlue": "#0000FF",
		"terminal.ansiBrightMagenta": "#FF00FF",
		"terminal.ansiBrightCyan": "#00FFFF",
		"terminal.ansiBrightWhite": "#FFFFFF"
	},
	"tokenColors": []
}
