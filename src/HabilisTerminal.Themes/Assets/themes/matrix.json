{
	// In the style of the film The Matrix (issue #123): phosphor green on black, with the pale green of the head of the
	// falling code for what must catch the eye. Red and blue stay in the terminal's palette as the two pills, so that
	// errors still stand out. Muted (issue #282): the neon greens (#00FF41, #00E63A) were too bright to look at for
	// long, so the greens are softer and less saturated. Not tinted with the Windows accent colour.
	"$schema": "vscode://schemas/color-theme",
	"name": "Matrix",
	"type": "dark",
	"colors": {
		"foreground": "#62BC74",
		"descriptionForeground": "#47905A",
		"errorForeground": "#D9665E",
		"focusBorder": "#6FCC82",
		"icon.foreground": "#62BC74",
		"widget.border": "#1F4A2B",

		"sideBar.background": "#060C08",
		"sideBar.foreground": "#62BC74",
		"sideBar.border": "#1F4A2B",
		"sideBarSectionHeader.background": "#0A150D",
		"sideBarSectionHeader.foreground": "#8AD49A",

		"list.activeSelectionBackground": "#2E6A3D",
		"list.activeSelectionForeground": "#D2EBD7",
		"list.inactiveSelectionBackground": "#14321E",
		"list.focusOutline": "#4FA663",
		"list.hoverBackground": "#0D1F13",
		"list.highlightForeground": "#C4E6CB",
		"gitDecoration.modifiedResourceForeground": "#C4E6CB",

		"titleBar.activeBackground": "#040805",
		"titleBar.activeForeground": "#6FCC82",
		"titleBar.inactiveBackground": "#040805",
		"titleBar.inactiveForeground": "#3F7A4C",

		"input.background": "#030604",
		"input.foreground": "#8AD49A",
		"input.border": "#1F4A2B",
		"input.placeholderForeground": "#3F7A4C",
		"quickInput.background": "#0A150D",
		"quickInput.foreground": "#62BC74",
		"editorWidget.background": "#0A150D",
		"editorWidget.border": "#1F4A2B",

		"button.background": "#2E6A3D",
		"button.foreground": "#D2EBD7",
		"button.hoverBackground": "#3A8350",
		"button.secondaryBackground": "#14321E",
		"button.secondaryForeground": "#8AD49A",

		"progressBar.background": "#4FA663",
		"scrollbarSlider.background": "#6FCC8238",
		"scrollbarSlider.hoverBackground": "#6FCC8260",
		"scrollbarSlider.activeBackground": "#6FCC8290",

		"editor.background": "#050A06",
		"editor.foreground": "#62BC74",
		"editor.selectionBackground": "#1F4A2B",
		"editor.lineHighlightBackground": "#0A150D",
		"editorCursor.foreground": "#C4E6CB",
		"editorLineNumber.foreground": "#3F7A4C",
		"textLink.foreground": "#8AD49A",
		"textCodeBlock.background": "#0A150D",

		"panel.background": "#050A06",
		"panel.border": "#1F4A2B",
		"terminal.background": "#050A06",
		"terminal.foreground": "#62BC74",
		"terminal.selectionBackground": "#1F4A2B",
		"terminalCursor.foreground": "#C4E6CB",
		"terminal.ansiBlack": "#050A06",
		"terminal.ansiRed": "#BE504A",
		"terminal.ansiGreen": "#4FA663",
		"terminal.ansiYellow": "#95BE72",
		"terminal.ansiBlue": "#4C74C4",
		"terminal.ansiMagenta": "#6AB385",
		"terminal.ansiCyan": "#5AB38A",
		"terminal.ansiWhite": "#A3CDAD",
		"terminal.ansiBrightBlack": "#3D6B4A",
		"terminal.ansiBrightRed": "#D9665E",
		"terminal.ansiBrightGreen": "#6FCC82",
		"terminal.ansiBrightYellow": "#B5D690",
		"terminal.ansiBrightBlue": "#7A9AD8",
		"terminal.ansiBrightMagenta": "#8CCCA2",
		"terminal.ansiBrightCyan": "#8AD4B0",
		"terminal.ansiBrightWhite": "#C4E6CB"
	},
	"tokenColors": [
		{ "scope": "comment", "settings": { "foreground": "#3D6B4A" } },
		{ "scope": ["string", "constant.other.symbol"], "settings": { "foreground": "#95BE72" } },
		{ "scope": ["constant.numeric", "constant.language", "constant.character"], "settings": { "foreground": "#8AD4B0" } },
		{ "scope": ["keyword", "storage", "storage.type"], "settings": { "foreground": "#C4E6CB" } },
		{ "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#8AD49A" } },
		{ "scope": ["entity.name.type", "entity.name.class", "support.type", "support.class"], "settings": { "foreground": "#6AB385" } },
		{ "scope": ["variable", "meta.definition.variable"], "settings": { "foreground": "#62BC74" } },
		{ "scope": "invalid", "settings": { "foreground": "#D9665E" } }
	]
}
