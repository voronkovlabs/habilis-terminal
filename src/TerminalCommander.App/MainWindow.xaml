<Window x:Class="TerminalCommander.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:layout="clr-namespace:TerminalCommander.App.Layout"
        xmlns:term="clr-namespace:Microsoft.Terminal.Wpf;assembly=Microsoft.Terminal.Wpf"
        Title="Terminal Commander"
        Width="1200" Height="800"
        Background="#181818"
        UseLayoutRounding="True"
        KeyboardNavigation.TabNavigation="None"
        KeyboardNavigation.ControlTabNavigation="None"
        KeyboardNavigation.DirectionalNavigation="None">
    <!-- Focus moves only through our own keys (Tab, Ctrl+Tab), never through WPF keyboard navigation. -->
    <layout:WorkspaceLayout x:Name="Workspace"
                            KeyboardNavigation.TabNavigation="None"
                            KeyboardNavigation.ControlTabNavigation="None"
                            KeyboardNavigation.DirectionalNavigation="None">
        <term:TerminalControl x:Name="Terminal" AutoResize="True" layout:WorkspaceLayout.Role="Terminal" />
    </layout:WorkspaceLayout>
</Window>
